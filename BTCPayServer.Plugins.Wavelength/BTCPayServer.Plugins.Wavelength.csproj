<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Plugin build settings -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>

    <!-- Enable XML documentation for IntelliSense -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Plugin Metadata -->
    <Product>Wavelength</Product>
    <Description>Adds wavelength, a self-custodial Ark/Lightning/on-chain wallet, to BTCPay Server as a Lightning wallet backend.</Description>
    <!-- Tracks the pinned lightninglabs/wavelength release in scripts/fetch-waved-native.sh -
         bump both together. -->
    <Version>0.2.1.0</Version>
    <Authors>Lightning Labs</Authors>
    <Company>Lightning Labs</Company>
    <PackageProjectUrl>https://github.com/lightninglabs/wavelength-btcpay</PackageProjectUrl>
    <RepositoryUrl>https://github.com/lightninglabs/wavelength-btcpay</RepositoryUrl>
    <PackageTags>btcpay;wavelength;ark;lightning;bitcoin;payments</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BTCPayServer.Plugins.Wavelength.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- BTCPay Server dependency (submodule) - exclude from plugin output, host already provides it -->
    <ProjectReference Include="..\btcpayserver\BTCPayServer\BTCPayServer.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <!--
      gRPC client for waved. Protos/ is vendored (not a submodule) from
      lightninglabs/wavelength - see Protos/VENDORED_COMMIT for the exact source
      commit and scripts/check-proto-drift.sh for the CI staleness check.
    -->
    <PackageReference Include="Grpc.Tools" Version="2.82.0" PrivateAssets="All" />
    <PackageReference Include="Grpc.Net.Client" Version="2.80.0" />
    <PackageReference Include="Google.Protobuf" Version="3.35.1" />
    <Protobuf Include="Protos\**\*.proto" GrpcServices="Client" ProtoRoot="Protos" />
  </ItemGroup>

  <!-- Include the native waved binaries in build output, once present (placed there manually
       for local dev - see scripts/plugin-register.sh, which runs a plain `dotnet build` and
       needs this for a debug session - or by DownloadWavedNativeForPublish below at publish
       time). -->
  <ItemGroup>
    <None Include="Native\**\*" Condition="Exists('Native')">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Link>Native\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <!-- Downloads and verifies the pinned lightninglabs/wavelength release's waved binary for
       every RID WavedProcessManager.GetRuntimeIdentifier() can return, into Native/<rid>/,
       before `dotnet publish` - so the BTCPay Plugin Builder (which only runs dotnet commands
       against this repo, not scripts/build-plugin.sh) produces a complete, runnable .btcpay
       without anyone building waved themselves. Skips a RID whose Native/<rid>/waved already
       exists, so a developer's own manually-placed local build (picked up by the ItemGroup
       above already) is left alone. See scripts/fetch-waved-native.sh for the pinned version,
       the hashes, and how to bump them.

       Adds straight to ResolvedFileToPublish below, inside this target, rather than relying on
       the top-level None ItemGroup above to cover publish too: that glob is captured once at
       project evaluation, and Build's own None -> _NoneWithTargetPath -> publish-list pass runs
       as part of Publish's ordinary dependency chain before this target gets a turn, so a RID
       directory THIS target creates during THIS publish would be invisible to that earlier
       pass and silently left out - re-declaring the same None items this late does not help,
       since nothing re-runs that pass over them afterward. ResolvedFileToPublish is the one
       item group still consumed AFTER this target runs (by the final publish copy step), which
       is what actually makes a from-scratch publish (no Native/ at all beforehand) bundle every
       RID this run just fetched; the top-level glob alone still covers plain `dotnet build` for
       local dev, and a RID that existed before THIS publish started is already included via
       that same earlier pass, so it is not duplicated here. -->
  <Target Name="DownloadWavedNativeForPublish" BeforeTargets="ComputeFilesToPublish">
    <Exec Command="bash &quot;$(MSBuildProjectDirectory)/../scripts/fetch-waved-native.sh&quot;" />
    <ItemGroup>
      <_WavedNativeFileNewlyFetched Include="Native\**\*" Exclude="@(None)" Condition="Exists('Native')" />
      <ResolvedFileToPublish Include="@(_WavedNativeFileNewlyFetched)">
        <RelativePath>Native\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
